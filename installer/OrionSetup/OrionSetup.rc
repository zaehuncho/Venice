#include <windows.h>

// Embed the UAC/DPI application manifest as RT_MANIFEST (resource id 1 =
// CREATEPROCESS_MANIFEST_RESOURCE_ID). The CMake target sets /MANIFEST:NO so the
// linker does not also emit a default manifest that would collide with this one.
1 24 "OrionSetup.manifest"

// Optional app icon: drop an "orion.ico" next to this .rc and uncomment.
// IDI_ICON1 ICON "orion.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Orion"
            VALUE "FileDescription",  "Orion Installer"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "OrionSetup"
            VALUE "LegalCopyright",   "Copyright (C) Orion"
            VALUE "OriginalFilename", "OrionSetup.exe"
            VALUE "ProductName",      "Orion"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
